@model ElectronicLibrary.Models.Book

<div class="page-container">
    <div class="card card-custom">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <img src="@(Model.CoverImageUrl ?? "/images/default-book.jpg")"
                         class="img-fluid rounded book-cover" alt="@Model.Title">
                </div>
                <div class="col-md-8">
                    <h1 class="section-title">@Model.Title</h1>
                    <h3 class="text-muted mb-4">@Model.Author</h3>

                    <div class="book-details">
                        <div class="detail-item mb-2">
                            <strong><i class="bi bi-tag me-2"></i>Категория:</strong> @Model.CategoryName
                        </div>
                        <div class="detail-item mb-2">
                            <strong><i class="bi bi-calendar me-2"></i>Год публикации:</strong>
                            @Model.PublicationDate.Year
                        </div>
                        <p class="lead mt-3">@Model.Description</p>
                    </div>

                    <div class="mt-4">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                <i class="bi bi-pencil me-2"></i>Редактировать
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger me-2">
                                <i class="bi bi-trash me-2"></i>Удалить
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Назад к списку
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
