@model ElectronicLibrary.ViewModels.CatalogViewModel

<div class="page-container">
    <h1 class="section-title text-center">
        <i class="bi bi-book me-2"></i>Каталог книг
    </h1>

    <div class="row">
        <div class="col-md-3">
            <div class="card card-custom mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <i class="bi bi-list-ul me-2"></i>Категории
                    </h3>
                    <div class="list-group">
                        @foreach (var category in Model.Categories)
                        {
                            <a asp-action="Index"
                               asp-route-category="@category.Name"
                               class="list-group-item list-group-item-action @(Model.SelectedCategory == category.Name ? "active" : "")">
                                <i class="bi bi-tag me-2"></i>@category.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-book-half me-2"></i>
                    @(string.IsNullOrEmpty(Model.SelectedCategory)
                        ? "Все книги"
                        : $"Книги в категории: {Model.SelectedCategory}")
                </h2>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle me-2"></i>Добавить книгу
                </a>
            </div>

            @if (Model.Books.Any())
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var book in Model.Books)
                    {
                        <div class="col">
                            <div class="card card-custom h-100">
                                <img src="@(book.CoverImageUrl ?? "/images/default-book.jpg")"
                                     class="card-img-top book-cover"
                                     alt="@book.Title">
                                <div class="card-body">
                                    <h5 class="card-title">@book.Title</h5>
                                    <p class="card-text text-muted">@book.Author</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-primary">
                                            <i class="bi bi-tag me-1"></i>@book.CategoryName
                                        </span>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar me-1"></i>
                                            @book.PublicationDate.Year
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0">
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="Details" asp-route-id="@book.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Детали
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@book.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil me-1"></i>Правка
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@book.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i>Удалить
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Пагинация -->
                <nav aria-label="Навигация по страницам" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-category="@Model.SelectedCategory"
                                   class="page-link">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle me-2"></i>
                    Книги не найдены. Попробуйте изменить параметры поиска.
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Плавное выделение активных элементов
        const activeElements = document.querySelectorAll('.active');
        activeElements.forEach(el => {
            el.classList.add('shadow-sm');
        });
    });
</script>
